# calendar-sync settings for Docker Compose: copy to .env next to compose.yaml.
# After a change: docker compose up -d

# Address users open the panel at. With a TLS reverse proxy in front, use https://
# and set SESSION_SECURE_COOKIE=true.
APP_URL=http://localhost:8080
SESSION_SECURE_COOKIE=false

# Port published on this machine
CALSYNC_HTTP_PORT=8080
# Address the port is published on: 0.0.0.0 = every network interface, 127.0.0.1 = only this
# machine (use it with a reverse proxy running on the same machine)
CALSYNC_BIND=0.0.0.0

# GUI and messages language: en or it
APP_LOCALE=en

# Timezone of the GUI and of the sync window, e.g. Europe/Rome or America/New_York
CALSYNC_TIMEZONE=UTC

# Encrypts the stored account credentials. Leave it empty to have it generated at the
# first start and kept in the data volume (/app/storage/app/app.key). Either way, back
# it up: without it the credentials cannot be decrypted.
APP_KEY=

# MySQL password (compose.yaml only). Choose a long random one before the first start:
# it is set when the database is created.
DB_PASSWORD=

# Proxies allowed to set X-Forwarded-* headers: Docker networks, where a reverse proxy
# on the same machine connects from.
TRUSTED_PROXIES=172.16.0.0/12

# Google OAuth client (docs/google-oauth.md). The redirect URI is APP_URL/oauth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# History of the runs, in days
CALSYNC_RUN_RETENTION_DAYS=30
# Log every CalDAV request (credentials masked), for troubleshooting
CALSYNC_HTTP_LOG=false
# Source code link on the privacy page (AGPL-3.0): set it to your fork if you modify the app
# CALSYNC_SOURCE_URL=https://github.com/laleace/calendar-sync

# Image version: latest, or a release such as 1.0.0
CALSYNC_VERSION=latest
