# Copy to /var/www/calendar-sync/.env (owner calsync, mode 600), then: php artisan key:generate
APP_NAME="Calendar Sync"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://calsync.example.com

# GUI and messages language: it or en
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# MySQL on the separate container
DB_CONNECTION=mysql
DB_HOST=192.168.1.51
DB_PORT=3306
DB_DATABASE=calendar_sync
DB_USERNAME=calendar_sync
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
# Must exceed the sync timeout (600 s)
DB_QUEUE_RETRY_AFTER=900
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# calendar-sync
CALSYNC_TIMEZONE=Europe/Rome
CALSYNC_RUN_RETENTION_DAYS=30
CALSYNC_HTTP_LOG=false
# Source code link on the privacy page (AGPL-3.0): set it to your fork if you modify the app
# CALSYNC_SOURCE_URL=https://github.com/laleace/calendar-sync

# nginx terminates TLS itself: only local proxies (a future cloudflared) are trusted
TRUSTED_PROXIES=127.0.0.1,::1

# Google OAuth client (docs/google-oauth.md). Register this redirect URI on Cloud Console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/oauth/google/callback"
